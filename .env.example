# Copy this file to .env in the project root and fill in the values.
# .env is gitignored and must never be committed.
#
# scripts/run.ps1 passes every key below to Maestro as -e KEY=VALUE.

# Android package under test. Each tenant ships its own build:
#   Bauchi      -> org.egov.bauchi
#   SMC-MC UAT  -> com.digit.hcm
#   mhbase UAT  -> com.digit.hcm  (file-based-download-mhbase-tenant.apk)
HCM_APP_ID=org.egov.bauchi

# One credential pair per role. Each subflows/sign-in/<role>.yaml hands its
# pair to subflows/login.yaml. Leave a role blank if you are not testing it.
# The pairs belong to one tenant; keep a copy of this file per tenant (e.g.
# mhbase.env - *.env is gitignored) and copy the one you need over .env.

# CDD user - subflows/sign-in/cdd.yaml
HCM_CDD_USER_ID=
HCM_CDD_PASSWORD=

# Health facility stock user
HCM_HF_STOCK_USER_ID=
HCM_HF_STOCK_PASSWORD=

# State stock user
HCM_STATE_STOCK_USER_ID=
HCM_STATE_STOCK_PASSWORD=

# National stock user
HCM_NAT_STOCK_USER_ID=
HCM_NAT_STOCK_PASSWORD=

# Test data expectations (optional).
# Whether the state stock user's Record Stock Receipt screen should list
# incoming transactions: present, absent, or blank to accept either.
# flows/stock/state-stock-incoming-receipts.yaml fails on a mismatch.
HCM_STATE_STOCK_INCOMING_RECEIPTS=

# The two products Case 2b accepts, one incoming transaction each, first _1
# then _2 (flows/stock/state-stock-accept-receipt.yaml). Written as the test
# data names them; the flows also match the app's spaced form ("SPAQ 1").
PRODUCT_VARIANT_1=SPAQ1
PRODUCT_VARIANT_2=SPAQ2

# Dispatch to a health facility (flows/stock/state-stock-dispatch.yaml).
# PRODUCT_VARIANT: the product(s) dispatched - one, or comma-separated
#   (SPAQ1,SPAQ2), run one after another in one session. Not as separate
#   runs: each run wipes the app, and stock records download only once.
# REMAINING_BALANCE: what Case 3 leaves in stock; it dispatches the rest.
# TARGET_HEALTH_FACILITY: optional; blank takes the first facility offered.
PRODUCT_VARIANT=SPAQ1,SPAQ2
REMAINING_BALANCE=10
TARGET_HEALTH_FACILITY=

# Return to National (flows/stock/state-stock-return.yaml), for
# PRODUCT_VARIANT_1 and PRODUCT_VARIANT_2 above.
# RETURN_DESTINATION: the National warehouse as Facility To lists it on the
#   Return form - the app shows facility codes, not "National".
RETURN_QUANTITY=5
EXPECTED_START_BALANCE=10
EXPECTED_FINAL_BALANCE=5
RETURN_DESTINATION=Fac_f-2026-10-15-137945

# Health facility accepts the state's dispatch
# (flows/stock/hf-stock-accept-receipt.yaml), for PRODUCT_VARIANT_1 / _2.
# TEST_USER: the account under test, for the report - must be the
#   HCM_HF_STOCK_USER_ID above, or the flow fails before signing in.
# EXPECTED_INITIAL_BALANCE / DISPATCHED_QTY_SPAQ1 / _SPAQ2: optional, and
#   best left blank - they change with every run. Blank, the flow logs the
#   opening balance, checks each card against Stock Receipt Details as read
#   during the run, and checks the balance rose by what was received. Set,
#   they must match (the balance before accepting; what the state
#   dispatched, per variant).
TEST_USER=AU-HFS-001
EXPECTED_INITIAL_BALANCE=
DISPATCHED_QTY_SPAQ1=
DISPATCHED_QTY_SPAQ2=

# Health facility dispatches to a CDD by QR code
# (flows/stock/hf-stock-dispatch-cdd.yaml), for PRODUCT_VARIANT with
# REMAINING_BALANCE above; TEST_USER as above.
# TARGET_CDD: the CDD's user name - what their QR code names; the scanned
#   code must match it.
# QR_CODE_PATH: that QR code as an image, relative to the project root.
#   scripts/prepare-qr-camera.ps1 (or .sh) shows it to the emulator camera.
TARGET_CDD=AU-CDD-001
QR_CODE_PATH=assets/qr/cdd_qr.png

# Health facility returns to the state (flows/stock/hf-stock-return-state.yaml),
# with PRODUCT_VARIANT_1 / _2, RETURN_QUANTITY, EXPECTED_START_BALANCE and
# EXPECTED_FINAL_BALANCE above. The state warehouse as the health facility's
# Return form lists it - a facility code, like RETURN_DESTINATION.
HF_RETURN_DESTINATION=Fac_f-2026-10-15-137946

# Stock reconciliation (flows/stock/state-stock-reconciliation.yaml and
# hf-stock-reconciliation.yaml), for PRODUCT_VARIANT_1 / _2 above.
# RECON_COMMENT: the comment entered for a count different from stock in
#   hand. ASCII only - Maestro's inputText on Android does not type other
#   characters (so "-", not an en dash).
# RECON_FACILITY: optional; the Select warehouse option to reconcile, as the
#   app lists it. Blank takes the first offered.
RECON_COMMENT=Automation test - reconciliation discrepancy
RECON_FACILITY=

# View Reports (flows/stock/state-stock-view-reports.yaml and
# hf-stock-view-reports.yaml). Optional, and best left blank: MRNs are made
# by the app at each dispatch, so these go stale with every run. Blank, each
# report's rows are read and logged. Set, the entries each report should hold,
# from the earlier prompts' execution reports:
#   Received / Issued / Returned: "<variant> <MRN> <quantity>", comma-separated
#   Reconciliation:               "<variant> <manual count>", comma-separated
#   Blank: none expected.
# REPORT_FACILITY: optional; the report's facility filter option. Blank takes
#   the first offered.
REPORT_FACILITY=
STATE_REPORT_RECEIVED=
STATE_REPORT_ISSUED=
STATE_REPORT_RETURNED=
STATE_REPORT_RECONCILIATION=
HF_REPORT_RECEIVED=
HF_REPORT_ISSUED=
HF_REPORT_RETURNED=
HF_REPORT_RECONCILIATION=

# Beneficiary Referral (flows/referral/hf-beneficiary-referral.yaml).
# REASON_1..4: the four referral reasons, worded as the app lists them.
# CHILD_AGE_MONTHS: 3 to 59. CHECKLIST_TEXT_ANSWER: typed into a checklist's
#   free-text questions (ASCII only - Maestro's inputText on Android).
# REFERRAL_VILLAGE / REFERRAL_CYCLE / CHILD_GENDER: optional; blank takes
#   the first offered.
REFERRAL_VILLAGE=
REFERRAL_CYCLE=
REASON_1=Fever
REASON_2=Sick
REASON_3=Drug side effect from the current cycle
REASON_4=Drug side effect from the previous cycle
CHILD_AGE_MONTHS=24
CHILD_GENDER=
CHECKLIST_TEXT_ANSWER=Automation test

# CDD registration and dose delivery (flows/registration/). Signs in as
# HCM_CDD_USER_ID; TEST_USER must match it for these flows.
# REGISTRATION_VILLAGE: optional; blank takes the first village offered.
# TEST_LATITUDE / TEST_LONGITUDE: decimal degrees inside the village, set as
#   the emulator's GPS fix (setLocation) on Beneficiary Location. Required.
# HOUSEHOLD_MEMBERS: 1 to 30. HEAD_AGE_YEARS: 18 to 149, HEAD_AGE_MONTHS:
#   0 to 11. HEAD_MOBILE: exactly 11 digits, a test number that is no real
#   person's; the 10- and 12-digit boundary values are derived from it.
# CHILD_1_AGE_MONTHS: 3 to 11 (expects PRODUCT_VARIANT_1). CHILD_2_AGE_MONTHS:
#   12 to 59 (expects PRODUCT_VARIANT_2).
# HEAD_GENDER / CHILD_1_GENDER / CHILD_2_GENDER: optional; blank takes the
#   first offered.
# EXPECTED_CDD_RECEIVED_SPAQ1 / _SPAQ2 / CDD_INCOMING_MRNS: optional, and best
#   left blank - they change with every dispatch. Blank, Step 11 accepts the
#   first transaction per variant and checks the balance rose by the quantity
#   Stock Receipt Details shows. Set: what the health facility dispatched to
#   the CDD, and that dispatch's MRNs (comma-separated).
REGISTRATION_VILLAGE=
TEST_LATITUDE=
TEST_LONGITUDE=
HOUSEHOLD_MEMBERS=3
HEAD_AGE_YEARS=30
HEAD_AGE_MONTHS=0
HEAD_GENDER=
HEAD_MOBILE=
CHILD_1_AGE_MONTHS=6
CHILD_1_GENDER=
CHILD_2_AGE_MONTHS=36
CHILD_2_GENDER=
EXPECTED_CDD_RECEIVED_SPAQ1=
EXPECTED_CDD_RECEIVED_SPAQ2=
CDD_INCOMING_MRNS=

# CDD registration with caregiver consent No (flows/registration/
# cdd-consent-no.yaml). Uses REGISTRATION_VILLAGE and TEST_LATITUDE /
# TEST_LONGITUDE above. CONSENT_REASON: typed as the reason for refusing
# (ASCII only). The consent itself is set by the flow, not here - a CONSENT
# key would reach every flow.
CONSENT_REASON=test

# CDD household of 20 with Unable to Deliver (flows/registration/
# cdd-household-utd.yaml). Its own keys, so Prompt 11's stay as they are;
# uses REGISTRATION_VILLAGE, TEST_LATITUDE / TEST_LONGITUDE, HEAD_MOBILE and
# PRODUCT_VARIANT_1 / _2 above.
# UTD_HOUSEHOLD_MEMBERS: 1 to 30. UTD_HEAD_AGE_YEARS: 18 to 149,
#   UTD_HEAD_AGE_MONTHS: 0 to 11. UTD_CHILD_n_AGE_MONTHS: 3 to 59 - two under
#   12 (PRODUCT_VARIANT_1) and two over (PRODUCT_VARIANT_2) cover both.
# UTD_HEAD_GENDER / UTD_CHILD_GENDER: optional; blank takes the first offered.
# UTD_REASON_1 to _4: the four Unable to Deliver reasons, as the app lists
#   them, all different; all blank uses the app's reason list in order.
UTD_HOUSEHOLD_MEMBERS=20
UTD_HEAD_AGE_YEARS=35
UTD_HEAD_AGE_MONTHS=0
UTD_HEAD_GENDER=
UTD_CHILD_1_AGE_MONTHS=6
UTD_CHILD_2_AGE_MONTHS=9
UTD_CHILD_3_AGE_MONTHS=24
UTD_CHILD_4_AGE_MONTHS=48
UTD_CHILD_GENDER=
UTD_REASON_1=
UTD_REASON_2=
UTD_REASON_3=
UTD_REASON_4=

# CDD household of 7 with dose and redose (flows/registration/
# cdd-household-redose.yaml). Its own keys, like UTD_* above; uses
# REGISTRATION_VILLAGE, TEST_LATITUDE / TEST_LONGITUDE, HEAD_MOBILE and
# PRODUCT_VARIANT_1 / _2. Child 1 (under 12 months, PRODUCT_VARIANT_1) and
# child 2 (12 or over, PRODUCT_VARIANT_2) get a dose and a redose; children
# 3 to 6 are registered only.
# REDOSE_REASON: typed if the redose asks for a reason (ASCII only).
REDOSE_HOUSEHOLD_MEMBERS=7
REDOSE_HEAD_AGE_YEARS=32
REDOSE_HEAD_AGE_MONTHS=0
REDOSE_HEAD_GENDER=
REDOSE_CHILD_1_AGE_MONTHS=6
REDOSE_CHILD_2_AGE_MONTHS=24
REDOSE_CHILD_3_AGE_MONTHS=4
REDOSE_CHILD_4_AGE_MONTHS=10
REDOSE_CHILD_5_AGE_MONTHS=15
REDOSE_CHILD_6_AGE_MONTHS=50
REDOSE_CHILD_GENDER=
REDOSE_REASON=

# CDD finds a household by Near by households and by ID (Prompt 18: flows/
# registration/cdd-search-nearby-and-id.yaml). The flow adds a household of
# a head and one child first, then searches for it. Its own keys, like
# UTD_* above; uses REGISTRATION_VILLAGE, HEAD_MOBILE and PRODUCT_VARIANT_1
# / _2. Leave TEST_LATITUDE / TEST_LONGITUDE blank for this flow: the
# household must be registered where the device is to count as near by.
# SEARCH_HOUSEHOLD_MEMBERS: 1 to 30. SEARCH_HEAD_AGE_YEARS: 18 to 149,
#   SEARCH_HEAD_AGE_MONTHS: 0 to 11. SEARCH_CHILD_1_AGE_MONTHS: 3 to 59.
# SEARCH_HEAD_GENDER / SEARCH_CHILD_GENDER: optional; blank takes the first
#   offered.
# SEARCH_UNKNOWN_ID: digits no beneficiary ID contains - typed in ID mode,
#   where it must find nothing.
SEARCH_HOUSEHOLD_MEMBERS=2
SEARCH_HEAD_AGE_YEARS=30
SEARCH_HEAD_AGE_MONTHS=0
SEARCH_HEAD_GENDER=
SEARCH_CHILD_1_AGE_MONTHS=6
SEARCH_CHILD_GENDER=
SEARCH_UNKNOWN_ID=000000000000

# CDD eligibility checklist leading to referral or ineligible (Prompt 19:
# flows/registration/cdd-eligibility-referral.yaml). The flow registers a
# head and four children and answers each child's checklist with one Yes:
# sick, fever, side effect (referral) and SP or CTX (ineligible). Its own
# keys, like UTD_* above; uses REGISTRATION_VILLAGE, TEST_LATITUDE /
# TEST_LONGITUDE, HEAD_MOBILE and PRODUCT_VARIANT_1 / _2. No stock needed.
# ELIG_HOUSEHOLD_MEMBERS: 1 to 30 (5 = the head and four children).
#   ELIG_HEAD_AGE_YEARS: 18 to 149, ELIG_HEAD_AGE_MONTHS: 0 to 11.
#   ELIG_CHILD_1_AGE_MONTHS to _4_: 3 to 59.
# ELIG_HEAD_GENDER / ELIG_CHILD_GENDER: optional; blank takes the first offered.
# ELIG_REFERRAL_FACILITY: optional; the Health facility chosen on Refer
#   Beneficiary, as the app lists it - blank takes the first offered.
ELIG_HOUSEHOLD_MEMBERS=5
ELIG_HEAD_AGE_YEARS=34
ELIG_HEAD_AGE_MONTHS=0
ELIG_HEAD_GENDER=
ELIG_CHILD_1_AGE_MONTHS=6
ELIG_CHILD_2_AGE_MONTHS=9
ELIG_CHILD_3_AGE_MONTHS=24
ELIG_CHILD_4_AGE_MONTHS=48
ELIG_CHILD_GENDER=
ELIG_REFERRAL_FACILITY=

# Rejecting incoming stock (Prompt 15: flows/stock/state-stock-reject-receipt
# .yaml, hf-stock-reject-receipt.yaml, cdd-stock-reject-receipt.yaml), for
# PRODUCT_VARIANT_1 / _2 above.
# REJECT_REASON: typed into the reject popup's reason field, when it has one.
#   ASCII only - Maestro's inputText on Android types nothing else.
REJECT_REASON=Automation test - stock rejected

# View Transactions (Prompt 16: flows/stock/state-stock-view-transactions
# .yaml, hf-stock-view-transactions.yaml, cdd-stock-view-transactions.yaml),
# for PRODUCT_VARIANT_1 / _2 above. Reads only.
# VIEW_TXN_EXPECTED_STATE / _HF / _CDD: optional. Transactions the role's list
#   must hold, comma-separated, each "<variant> <quantity>" or
#   "<variant> <MRN> <quantity>" (e.g. SPAQ1 490,SPAQ2 490). Blank: the list
#   is logged and nothing is expected. A receiver's acceptance can change the
#   MRN the sender sees, so give an MRN only when it is known to be stable.
VIEW_TXN_EXPECTED_STATE=
VIEW_TXN_EXPECTED_HF=
VIEW_TXN_EXPECTED_CDD=

# Boundary data check after Submit on boundary selection - health facility
# and CDD (Prompt 17: subflows/home/boundary-data.yaml, used by every flow
# that signs in as either; flows/onboarding/*-boundary-data.yaml).
# BOUNDARY_DATA_CHOICE: on "Data found!", Download (copies the boundary's
#   records to the device; changes nothing on the server) or Proceed
#   (Proceed Without Downloading). Blank: Download.
# BOUNDARY_DATA_RETRIES: how many times to Retry "Failed to check data in
#   server" before Proceed Without Downloading. Blank: 2.
BOUNDARY_DATA_CHOICE=Download
BOUNDARY_DATA_RETRIES=2

# Chained runs (scripts/run-chain.ps1 - each role's flows back to back in
# one app session, then logout).
# DISPATCH_PARTS: how many dispatches Case 3 of the dispatch flows makes -
#   blank: one. run-chain.ps1 passes 2 itself, so the next role has one
#   transaction to accept and one to reject.
# KEEP_SESSION is NOT set here: run-chain.ps1 (or run.ps1 -KeepSession) passes
#   it per run. Set in .env, every flow would reuse whatever session the app
#   holds instead of signing in fresh.
DISPATCH_PARTS=

# Add a key here for every new variable a flow reads. Anything a flow
# references but no one sets resolves to the literal string "undefined".
# Never add LOGIN_USER_ID / LOGIN_PASSWORD - see subflows/login.yaml.
