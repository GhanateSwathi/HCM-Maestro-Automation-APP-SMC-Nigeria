# Credentials and environment-specific values. Never commit .env - only the
# .env.example template is tracked.
.env
*.env
!.env.example

# Screenshots and run output
artifacts/
.maestro/
*.mp4
*.png

# DB audit: a live form config or labels logged from the app stay local
# (client data). Python caches, and LibreOffice lock files of an open sheet.
db-audit/config/
__pycache__/
.~lock.*#

# OS
.DS_Store
Thumbs.db
